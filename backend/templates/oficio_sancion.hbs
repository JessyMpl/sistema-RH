<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aviso de Sanción</title>
<style>
    /* Estructura base aplicando la clase solicitada */
    .img-strattia-style {
        font-family: Arial, Helvetica, sans-serif;
        max-width: 900px;
        margin: 20px auto;
        color: #000;
        font-size: 12px;
        line-height: 1.4;
        background-color: #fff;
        padding: 20px;
    }
    
    .img-strattia-style *, .img-strattia-style *::before, .img-strattia-style *::after {
        box-sizing: border-box;
    }

    /* Utilidades */
    .highlight { background-color: transparent; font-weight: bold; padding: 0 3px; }
    .border-box { border: 1.5px solid #000; padding: 5px; margin-bottom: 5px; }
    .font-bold { font-weight: bold; }
    .text-center { text-align: center; }

    /* Cabecera */
    .header-container { display: flex; align-items: center; margin-bottom: 15px; }
    .logo-placeholder { width: 90px; height: 100px; margin-right: 20px; object-fit: contain; }
    .header-text { font-size: 12px; line-height: 1.2; }
    .header-text .title { font-size: 10px; font-weight: bold; margin-bottom: 2px; }

    /* Título principal */
    .main-title {
        border: 3px solid #000;
        text-align: center;
        font-weight: bold;
        font-size: 14px;
        padding: 10px;
        margin-bottom: 15px;
    }

    /* Fecha */
    .date-row { text-align: right; margin-bottom: 5px; font-weight: bold; }
    .date-boxes { display: inline-flex; border: 1px solid #000; margin-left: 5px; font-weight: normal; }
    .date-boxes div { border-right: 1px solid #000; padding: 2px 10px; }
    .date-boxes div:last-child { border-right: none; }

    /* Grids de layout */
    .grid-row-1 { display: grid; grid-template-columns: 75% 24%; gap: 5px; margin-bottom: 5px; }
    .grid-row-2 { display: grid; grid-template-columns: 17.5% 15% 66%; gap: 5px; margin-bottom: 5px; }
    
    .name-fields { display: flex; justify-content: center; padding: 0 30px; margin-top: 15px; }
    .name-fields > div { text-align: center; }
    .name-fields span.label { font-size: 10px; font-weight: normal; display: block; margin-top: 2px; }

    /* Checkboxes */
    .checkbox {
        display: inline-block;
        width: 16px; height: 16px;
        border: 1px solid #000;
        text-align: center;
        line-height: 14px;
        font-size: 11px;
        font-weight: bold;
        vertical-align: middle;
        margin: 0 4px;
    }

    /* Tabla de registro de incidencias */
    .incidencias-table { width: 100%; border-collapse: collapse; }
    .incidencias-table td { padding: 4px 0; vertical-align: top; }
    
    /* Sección Sanción */
    .sancion-line { border-bottom: 1px solid #000; display: inline-block; text-align: center; }

    /* Firmas */
    .signatures { width: 100%; border-collapse: collapse; margin-bottom: 5px; text-align: center; font-size: 11px; }
    .signatures th, .signatures td { border: 1.5px solid #000; padding: 0; }
    .sig-top { height: 70px; vertical-align: top; padding-top: 5px !important; }
    .sig-bottom { vertical-align: bottom; padding-bottom: 5px !important; }

    .inner-date { width: 100%; border-collapse: collapse; margin-top: 5px; }
    .inner-date td { border: none; border-top: 1.5px solid #000; border-right: 1.5px solid #000; padding: 2px; }
    .inner-date td:last-child { border-right: none; }
    
    /* Pie de página */
    .footer-box { border: 1px solid #000; padding: 2px 5px; font-size: 8px; line-height: 1.2; margin-top: 5px; }
</style>
</head>
<body>

<div class="img-strattia-style">

    <!-- Encabezado -->
    <div class="header-container">
        <img src="{{{imagen_escudo}}}" alt="Escudo del Estado de México" class="logo-placeholder"> 
        <div class="header-text">
            <div class="title">Gobierno del Estado de México</div>
            <div>Secretaría de Finanzas</div>
            <div>Subsecretaría de Administración</div>
            <div>Dirección General de Personal</div>
        </div>
    </div>

    <!-- Título Principal -->
    <div class="main-title">
        AVISO DE SANCIÓN POR FALTAS DE PUNTUALIDAD Y ASISTENCIA
    </div>

    <!-- Fecha -->
    <div class="date-row">
        FECHA: 
        <div class="date-boxes">
            <div class="highlight">{{dia_hoy}}</div>
            <div class="highlight">{{mes_hoy}}</div>
            <div class="highlight">{{anio_hoy}}</div>
        </div>
    </div>

    <!-- Fila 1: Nombres y Clave -->
    <div class="grid-row-1">
        <div class="border-box">
            <div class="font-bold text-center" style="background-color: #e6e6e6; border-bottom: 1px solid #000; padding: 2px;">Nombre del servidor público<br></div>
            <div class="name-fields">
                <div>
                    <span class="highlight" style="font-size: 12px; padding: 5px;">{{nombre_completo_ordenado}}</span>
                    <span class="label" style="border-top: 1px dotted #ccc; padding-top: 2px; margin-top: 5px;">Nombre &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Apellido Paterno &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Apellido Materno</span>
                </div>
            </div>
        </div>
        <div class="border-box text-center">
            <div class="font-bold" style="background-color: #e6e6e6; border-bottom: 1px solid #000; padding: 2px; font-size: 11px;">Clave de servidor<br>público</div>
            <div style="margin-top: 12px; font-size: 11px;">
                <span class="highlight">{{clave_servidor}}</span>
            </div>
        </div>
    </div>

    <!-- Fila 2: Plaza, CCT, Horario -->
    <div class="grid-row-2">
        <div class="border-box">
            <div class="font-bold text-center" style="background-color: #e6e6e6; border-bottom: 1px solid #000;">Núm. de Plaza</div>
            <div class="text-center highlight" style="height: 18px; padding-top: 2px;">{{num_plaza}}</div>
        </div>
        <div class="border-box text-center">
            <div class="font-bold" style="background-color: #e6e6e6; border-bottom: 1px solid #000;">CCT<br></div>
            <div class="highlight" style="height: 18px; padding-top: 2px;">{{cct}}</div>
        </div>
        <div class="border-box"> 
            <span class="font-bold">Horario asignado:</span>
            <span class="highlight" style="margin-left: 18px;">{{horario}}</span>
            <div style="border-bottom: 1px solid #000; margin-top: 5px; margin-right: 5px; height: 5px;"></div>
        </div>
    </div>

    <!-- Fila 3: Registro e Incidencias -->
    <div class="border-box">
        <table class="incidencias-table">
            <tr>
                <td style="width: 25%;" class="font-bold">Registro de asistencia:</td>
                <td style="width: 25%;"><div class="checkbox"></div> Gafete / Credencial</td>
                <td style="width: 25%;"><div class="checkbox">X</div> Reloj de registro</td>
                <td style="width: 25%;"><div class="checkbox"></div> Lista de asistencia</td>
            </tr>
           <tr>
                <td class="font-bold" style="padding-top: 10px;">Tipo y número de<br>Incidencias:</td>
                <td style="padding-top: 15px;"><div class="checkbox highlight">{{check_puntualidad}}</div> Puntualidad</td>
                <td style="padding-top: 15px;"><div class="checkbox highlight">{{check_asistencia}}</div> Asistencia</td>
                <td></td>
            </tr>
        </table>
    </div>

    <!-- Fila 4: Sanción y Fundamento -->
    <div class="border-box">
        <div style="margin-bottom: 8px;">
            <span class="font-bold">Mes en que ocurrieron las incidencias</span> 
            <span class="sancion-line highlight" style="width: 80px; text-transform: uppercase;">{{mes_incidencia}}</span>
            <span class="font-bold" style="margin-left: 10px;">Sanción</span>
            <span class="sancion-line highlight" style="width: auto; min-width: 200px;">{{sancion_texto}}</span>
        </div>
        <div style="margin-bottom: 15px;">
            <span style="display:inline-block; width: 120px;">correspondiente al</span> 
            <span class="sancion-line highlight" style="width: auto; min-width: 300px;">{{dias_incidencia_texto}} del mes de {{mes_incidencia}} de {{anio_hoy}}.<br>{{texto_suspension}}</span>
        </div>
        
        <div class="font-bold" style="margin-bottom: 10px;">
            Con fundamento en lo establecido en el Manual de Normas y Procedimientos de Desarrollo y Administración de Personal.
        </div>
        
        <div style="display: flex; justify-content: space-around; margin-bottom: 5px;">
            <div>
                ▪ 20301/206-01 inciso 
                <span style="margin-left:5px;">a</span> <div class="checkbox highlight">{{check_206_01}}</div> 
                <span style="margin-left:5px;">b</span> <div class="checkbox">{{check_206_01_b}}</div>
            </div>
            <div>
                ▪ 20301/206-02 inciso 
                <span style="margin-left:5px;">a</span> <div class="checkbox highlight">{{check_206_02}}</div> 
                <span style="margin-left:5px;">b</span> <div class="checkbox">{{check_206_02_b}}</div> 
                <span style="margin-left:5px;">c</span> <div class="checkbox">{{check_206_02_c}}</div>
            </div>
        </div>
    </div>

    <!-- Tabla de Firmas -->
    <table class="signatures">
        <tr>
            <td style="width: 33.33%; background-color: #e6e6e6;" class="font-bold">ELABORA</td>
            <td style="width: 33.33%; background-color: #e6e6e6;" class="font-bold">AUTORIZA</td>
            <td style="width: 33.33%; background-color: #e6e6e6;" class="font-bold">ENTERADO</td>
        </tr>
        <tr>
            <td class="sig-top sig-bottom">
                <span class="font-bold">L. en D. Olivia Carrillo Delgadillo</span><br>
                Coordinadora Administrativa
            </td>
            <td class="sig-top sig-bottom">
                <span class="font-bold">{{nombre_autoriza}}</span><br>
                {{cargo_autoriza}}
            </td>
            <td class="sig-top sig-bottom">
                <span class="font-bold">{{nombre_completo_ordenado}}</span><br>
                Servidor Público
            </td>
        </tr>
        <tr>
            <!-- Fecha Elabora -->
            <td>
                <table class="inner-date">
                    <tr style="background-color: #e6e6e6; font-size: 10px;" class="font-bold">
                        <td>DÍA</td><td>MES</td><td>AÑO</td>
                    </tr>
                    <tr>
                        <td class="highlight font-bold">{{dia_hoy}}</td><td class="highlight font-bold">{{mes_hoy}}</td><td class="highlight font-bold">{{anio_hoy}}</td>
                    </tr>
                </table>
            </td>
            <!-- Fecha Autoriza -->
            <td>
                <table class="inner-date">
                    <tr style="background-color: #e6e6e6; font-size: 10px;" class="font-bold">
                        <td>DÍA</td><td>MES</td><td>AÑO</td>
                    </tr>
                    <tr>
                        <td class="highlight font-bold">{{dia_hoy}}</td><td class="highlight font-bold">{{mes_hoy}}</td><td class="highlight font-bold">{{anio_hoy}}</td>
                    </tr>
                </table>
            </td>
            <!-- Fecha Enterado -->
            <td>
                <table class="inner-date">
                    <tr style="background-color: #e6e6e6; font-size: 10px;" class="font-bold">
                        <td>DÍA</td><td>MES</td><td>AÑO</td>
                    </tr>
                    <tr>
                        <td class="highlight font-bold">{{dia_hoy}}</td><td class="highlight font-bold">{{mes_hoy}}</td><td class="highlight font-bold">{{anio_hoy}}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Pie de página -->
    <div class="footer-box">
        Original Servidor público<br>
        C.c.p. Dirección de Remuneraciones al Personal<br>
        C.c.p. Superior inmediato<br>
        C.c.p. Coordinador Administrativo o equivalente
    </div>
    
    <div style="text-align: right; font-size: 10px; margin-top: 8px; font-weight: bold;">
        20301/NP-59/04/A
    </div>

</div>

</body>
</html>