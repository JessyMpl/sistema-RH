generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Tipos de régimen (Aquí vive la lógica de tus macros de Excel)
enum Regimen {
  NORMAL    // Para el personal con horario de oficina (Biométrico)
  ESPECIAL  // Para personal 1x1 o guardias (Lógica de 2 días)
  LISTA     // Para personal que checa por lista (Marca "LA" automáticamente)
  EXENTO    // Para el personal que no registra asistencia por ninguna 
}

// 2. Tabla de Horarios
model Horario {
  id          Int               @id @default(autoincrement())
  nombre      String            // Ejemplo: "Administrativo", "Seguridad 24x48"
  horaEntrada String            // "09:00"
  horaSalida  String            // "18:00"
  servidores  ServidorPublico[]
}

// 3. Tabla del Personal (Actualizada con Fecha de Ingreso e Historial de Movimientos)
model ServidorPublico {
  id             Int          @id @default(autoincrement())
  nombreCompleto String
  numeroEmpleado String       @unique 
  departamento   String?            
  regimen        Regimen      @default(NORMAL)
  activo         Boolean      @default(true)
  horarioId      Int
  
  // CAMPOS DE CONTROL DE EXPEDIENTE
  fechaIngreso   DateTime?    @db.Date  // Nueva columna para la fecha de alta institucional
  fechaBaja      DateTime?    @db.Date
  motivoBaja     String?      @db.Text

  horario         Horario               @relation(fields: [horarioId], references: [id])
  asistencias     Asistencia[]
  historial       HistorialMovimiento[] // Relación inversa para acceder a la bitácora del empleado
  justificaciones Justificacion[]       // NUEVO: Relación para el historial de justificaciones del empleado
}

// 4. Tabla de Asistencias (Tu hoja de "reporte" depurada)
model Asistencia {
  id             Int             @id @default(autoincrement())
  fecha          DateTime        @db.Date
  entrada        String?         // Almacenamos "08:45"
  salida         String?         // Almacenamos "18:10"
  minutosRetardo Int             @default(0)
  incidencia     String?         // Para guardar "LA", "FALTA", "RETARDO", etc.
  servidorId     Int
  
  servidor       ServidorPublico @relation(fields: [servidorId], references: [id])
  justificacion  Justificacion?  // NUEVO: Relación 1 a 1 con la justificación

  // Esta regla garantiza que no haya registros duplicados el mismo día para la misma persona
  @@unique([servidorId, fecha])
}

// 5. Tabla de Usuarios (Para el acceso al sistema)
model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String   @unique
  password String
  rol      String   @default("RH")
}

// 6. NUEVA TABLA: Bitácora Histórica de Movimientos del Personal
model HistorialMovimiento {
  id             Int             @id @default(autoincrement())
  servidorId     Int
  tipoMovimiento String          // "CAMBIO DE DEPARTAMENTO", "CAMBIO DE RÉGIMEN", "ALTA", etc.
  datoAnterior   String?         @db.Text // Valor que tenía antes del cambio
  datoNuevo      String?         @db.Text // Nuevo valor asignado
  fecha          DateTime        @default(now()) // Cuándo ocurrió el movimiento

  servidor       ServidorPublico @relation(fields: [servidorId], references: [id])
}

// 7. NUEVA TABLA: Justificaciones de Incidencias
model Justificacion {
  id                Int             @id @default(autoincrement())
  motivo            String          // Ej: "OFICIO DE COMISIÓN", "INCAPACIDAD MÉDICA", "ONOMÁSTICO"
  folioDocumento    String?         // Ej: "SM-001-2026" para guardar la referencia del papel
  observaciones     String?         @db.Text
  cobertura         String          @default("COMPLETO") // 👈 AQUÍ ESTÁ EL CAMPO NUEVO
  fechaRegistro     DateTime        @default(now())

  // Relación con el servidor público para fácil acceso
  servidorId        Int
  servidor          ServidorPublico @relation(fields: [servidorId], references: [id])

  // Relación 1 a 1 con la asistencia (Cada incidencia justificada se liga a su registro de asistencia)
  asistenciaId      Int             @unique
  asistencia        Asistencia      @relation(fields: [asistenciaId], references: [id])
}

