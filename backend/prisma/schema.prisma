generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Tipos de régimen (Aquí vive la lógica de tus macros de Excel)
enum Regimen {
  NORMAL    // Para el personal con horario de oficina (Biométrico)
  ESPECIAL  // Para personal 1x1 o guardias (Lógica de 2 días)
  LISTA     // Para personal que checa por lista (Marca "LA" automáticamente)
  EXENTO    // Para el personal que no registra asistencia por ninguna 
}

// 2. Tabla de Horarios
model Horario {
  id          Int               @id @default(autoincrement())
  nombre      String            // Ejemplo: "Administrativo", "Seguridad 24x48"
  horaEntrada String            // "09:00"
  horaSalida  String            // "18:00"
  servidores  ServidorPublico[]
}

// ===============================================
// NUEVO: Catálogo de Áreas de Adscripción
// ===============================================
model AreaAdscripcion {
  id          Int               @id @default(autoincrement())
  nombre      String            @unique // Ej: "DIRECCIÓN DE FINANZAS" o "DEPTO. DE SISTEMAS"
  activo      Boolean           @default(true)
  
  servidores  ServidorPublico[]
}

// 3. Tabla del Personal (Actualizada con Catálogo de Área)
model ServidorPublico {
  id             Int          @id @default(autoincrement())
  nombreCompleto String
  numeroEmpleado String       @unique 
  
  // El cambio: Ahora es una relación, no texto libre
  areaId         Int?
  area           AreaAdscripcion? @relation(fields: [areaId], references: [id])
  
  regimen        Regimen      @default(NORMAL)
  activo         Boolean      @default(true)
  horarioId      Int
  
  // CAMPOS DE CONTROL DE EXPEDIENTE
  fechaIngreso   DateTime?    @db.Date
  fechaBaja      DateTime?    @db.Date
  motivoBaja     String?      @db.Text

  horario         Horario               @relation(fields: [horarioId], references: [id])
  asistencias     Asistencia[]
  historial       HistorialMovimiento[] 
  justificaciones Justificacion[]       
  sanciones       SancionMensual[]      
}

// 4. Tabla de Asistencias (Tu hoja de "reporte" depurada)
model Asistencia {
  id             Int             @id @default(autoincrement())
  fecha          DateTime        @db.Date
  entrada        String?         // Almacenamos "08:45"
  salida         String?         // Almacenamos "18:10"
  minutosRetardo Int             @default(0)
  incidencia     String?         // Para guardar "LA", "FALTA", "RETARDO", etc.
  servidorId     Int
  
  servidor       ServidorPublico @relation(fields: [servidorId], references: [id])
  justificacion  Justificacion?  // NUEVO: Relación 1 a 1 con la justificación

  // Esta regla garantiza que no haya registros duplicados el mismo día para la misma persona
  @@unique([servidorId, fecha])
}

// 5. Tabla de Usuarios (Para el acceso al sistema)
model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String   @unique
  password String
  rol      String   @default("RH")
}

// 6. NUEVA TABLA: Bitácora Histórica de Movimientos del Personal
model HistorialMovimiento {
  id             Int             @id @default(autoincrement())
  servidorId     Int
  tipoMovimiento String          // "CAMBIO DE DEPARTAMENTO", "CAMBIO DE RÉGIMEN", "ALTA", etc.
  datoAnterior   String?         @db.Text // Valor que tenía antes del cambio
  datoNuevo      String?         @db.Text // Nuevo valor asignado
  fecha          DateTime        @default(now()) // Cuándo ocurrió el movimiento

  servidor       ServidorPublico @relation(fields: [servidorId], references: [id])
}

// 7. NUEVA TABLA: Justificaciones de Incidencias
model Justificacion {
  id                Int              @id @default(autoincrement())
  motivo            String           // Ej: "OFICIO DE COMISIÓN", "INCAPACIDAD MÉDICA", "ONOMÁSTICO"
  folioDocumento    String?          // Ej: "SM-001-2026" para guardar la referencia del papel
  observaciones     String?          @db.Text
  cobertura         String           @default("COMPLETO") // 
  fechaRegistro     DateTime         @default(now())

  // Relación con el servidor público para fácil acceso
  servidorId        Int
  servidor          ServidorPublico @relation(fields: [servidorId], references: [id])

  // Relación 1 a 1 con la asistencia (Cada incidencia justificada se liga a su registro de asistencia)
  asistenciaId      Int              @unique
  asistencia        Asistencia      @relation(fields: [asistenciaId], references: [id])
}

// 8. TABLA DE REGISTROS DE ASISTENCIA (CRON / APP ELECTRON)
model AttendanceRecord {
  id           BigInt   @id @default(autoincrement())
  employeeId   String   @map("employee_id") @db.VarChar(50)
  timestamp    String   @map("timestamp") @db.VarChar(50)
  serialNumber String   @map("serial_number") @db.VarChar(50)
  cardNumber   String?  @default("") @map("card_number") @db.VarChar(50)
  source       String   @default("unknown") @map("source") @db.VarChar(30)
  clockIp      String?  @default("") @map("clock_ip") @db.VarChar(45)
  clockName    String?  @default("") @map("clock_name") @db.VarChar(100)
  syncDate     DateTime @default(now()) @map("sync_date") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([employeeId, timestamp, serialNumber], name: "uq_attendance_record")
  @@map("attendance_records")
}

// 9. TABLA DE CALENDARIO (CATÁLOGO DE FECHAS A 15 AÑOS O MÁS)
model Calendario {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @unique @db.Date
  anio      Int
  mes       Int
  dia       Int
  semana    Int      // Semana del año (1 a 53)
  diaSemana Int      // Día de la semana (1 = Lunes, 7 = Domingo)
  quincena  Int      // Quincena (1 o 2)
  esLaboral Boolean  @default(true) // Lunes a Viernes = true, Sábado/Domingo = false

  @@map("calendario")
}

// 10. TABLA DE HISTORIAL DE SANCIONES MENSUALES
model SancionMensual {
  id               Int              @id @default(autoincrement())
  servidorId       Int
  mes              Int              // Ej. 6 para Junio
  anio             Int              // Ej. 2026
  tipoSancion      String           // "RETARDOS" o "FALTAS"
  
  // Evidencia matemática específica de esta sanción
  totalRetardos    Int              @default(0)
  totalFaltas      Int              @default(0)
  totalOmisiones   Int              @default(0) 
  
  // Castigos aplicados
  sancionAplicada  String           @db.Text 
  diasDescuento    Int              @default(0)
  
  // Rastro documental
  folioOficio      String?          
  fechaEmision     DateTime         @default(now())
  
  // Relación con el empleado
  servidor         ServidorPublico @relation(fields: [servidorId], references: [id])
}

// ==============================================================================
// 11. 🔥 NUEVA TABLA: CATÁLOGO DE DÍAS INHÁBILES Y PERIODOS VACACIONALES
// ==============================================================================
model DiaInhabil {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @unique @db.Date
  tipo        String   // 'FERIADO' o 'VACACIONES'
  descripcion String   // Ej. "Día del Trabajo", "Primer Periodo Vacacional"
  createdAt   DateTime @default(now())

  @@map("dias_inhabiles")
}